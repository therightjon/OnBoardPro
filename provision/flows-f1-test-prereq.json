{
 "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
 "contentVersion": "1.0.0.0",
 "parameters": {
  "$connections": {
   "defaultValue": {},
   "type": "Object"
  },
  "$authentication": {
   "defaultValue": {},
   "type": "SecureObject"
  }
 },
 "triggers": {
  "Recurrence": {
   "recurrence": {
    "frequency": "Month",
    "interval": 12
   },
   "type": "Recurrence"
  }
 },
 "actions": {
  "Inputs": {
   "runAfter": {},
   "type": "Compose",
   "inputs": {
    "candidateId": 1,
    "mode": "prereq"
   }
  },
  "Get_Candidate": {
   "runAfter": {
    "Inputs": [
     "Succeeded"
    ]
   },
   "type": "OpenApiConnection",
   "inputs": {
    "host": {
     "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
     "connectionName": "shared_sharepointonline",
     "operationId": "HttpRequest"
    },
    "parameters": {
     "dataset": "https://uab365.sharepoint.com/sites/obgyn/OBGYN-Onboarding",
     "parameters/method": "GET",
     "parameters/uri": "_api/web/lists(guid'ce3de9a9-702d-4707-9f30-a011b3d78264')/items(@{outputs('Inputs')?['candidateId']})",
     "parameters/headers": {
      "Accept": "application/json;odata=nometadata",
      "Content-Type": "application/json;odata=nometadata"
     }
    },
    "authentication": "@parameters('$authentication')"
   }
  },
  "PreDone": {
   "runAfter": {
    "Get_Candidate": [
     "Succeeded"
    ]
   },
   "type": "Compose",
   "inputs": "@not(empty(coalesce(body('Get_Candidate')?['PrereqsExpanded'],'')))"
  },
  "Already": {
   "runAfter": {
    "PreDone": [
     "Succeeded"
    ]
   },
   "type": "Compose",
   "inputs": "@or(and(equals(outputs('Inputs')?['mode'],'full'), not(empty(coalesce(body('Get_Candidate')?['TemplateApplied'],'')))), and(equals(outputs('Inputs')?['mode'],'prereq'), equals(outputs('PreDone'), true)))"
  },
  "If_NotAlready": {
   "runAfter": {
    "Already": [
     "Succeeded"
    ]
   },
   "type": "If",
   "expression": {
    "and": [
     {
      "equals": [
       "@outputs('Already')",
       false
      ]
     }
    ]
   },
   "actions": {
    "Claim": {
     "runAfter": {},
     "type": "If",
     "expression": {
      "and": [
       {
        "equals": [
         "@outputs('Inputs')?['mode']",
         "full"
        ]
       }
      ]
     },
     "actions": {
      "Claim_Full": {
       "runAfter": {},
       "type": "OpenApiConnection",
       "inputs": {
        "host": {
         "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
         "connectionName": "shared_sharepointonline",
         "operationId": "HttpRequest"
        },
        "parameters": {
         "dataset": "https://uab365.sharepoint.com/sites/obgyn/OBGYN-Onboarding",
         "parameters/method": "POST",
         "parameters/uri": "_api/web/lists(guid'ce3de9a9-702d-4707-9f30-a011b3d78264')/items(@{outputs('Inputs')?['candidateId']})",
         "parameters/headers": {
          "Accept": "application/json;odata=nometadata",
          "Content-Type": "application/json;odata=nometadata",
          "X-HTTP-Method": "MERGE",
          "IF-MATCH": "*"
         },
         "parameters/body": "@string(json(concat('{\"TemplateApplied\":\"', utcNow('yyyy-MM-dd'), '\"}')))"
        },
        "authentication": "@parameters('$authentication')"
       }
      }
     },
     "else": {
      "actions": {
       "Claim_Prereq": {
        "runAfter": {},
        "type": "OpenApiConnection",
        "inputs": {
         "host": {
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
          "connectionName": "shared_sharepointonline",
          "operationId": "HttpRequest"
         },
         "parameters": {
          "dataset": "https://uab365.sharepoint.com/sites/obgyn/OBGYN-Onboarding",
          "parameters/method": "POST",
          "parameters/uri": "_api/web/lists(guid'ce3de9a9-702d-4707-9f30-a011b3d78264')/items(@{outputs('Inputs')?['candidateId']})",
          "parameters/headers": {
           "Accept": "application/json;odata=nometadata",
           "Content-Type": "application/json;odata=nometadata",
           "X-HTTP-Method": "MERGE",
           "IF-MATCH": "*"
          },
          "parameters/body": "@string(json(concat('{\"PrereqsExpanded\":\"', utcNow('yyyy-MM-dd'), '\"}')))"
         },
         "authentication": "@parameters('$authentication')"
        }
       }
      }
     }
    },
    "Get_TS": {
     "runAfter": {
      "Claim": [
       "Succeeded"
      ]
     },
     "type": "OpenApiConnection",
     "inputs": {
      "host": {
       "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
       "connectionName": "shared_sharepointonline",
       "operationId": "HttpRequest"
      },
      "parameters": {
       "dataset": "https://uab365.sharepoint.com/sites/obgyn/OBGYN-Onboarding",
       "parameters/method": "GET",
       "parameters/uri": "_api/web/lists(guid'4b2a8192-4607-4634-b8d6-7ad25e35689b')/items?$select=Id,StageId,OrderIndex,Phase&$filter=TemplateId eq @{body('Get_Candidate')?['TemplateId']}&$top=50",
       "parameters/headers": {
        "Accept": "application/json;odata=nometadata",
        "Content-Type": "application/json;odata=nometadata"
       }
      },
      "authentication": "@parameters('$authentication')"
     }
    },
    "Get_Stages": {
     "runAfter": {
      "Get_TS": [
       "Succeeded"
      ]
     },
     "type": "OpenApiConnection",
     "inputs": {
      "host": {
       "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
       "connectionName": "shared_sharepointonline",
       "operationId": "HttpRequest"
      },
      "parameters": {
       "dataset": "https://uab365.sharepoint.com/sites/obgyn/OBGYN-Onboarding",
       "parameters/method": "GET",
       "parameters/uri": "_api/web/lists(guid'f2f31e7b-1652-47fb-b215-775bdaa4a0fa')/items?$select=Id,Title&$top=50",
       "parameters/headers": {
        "Accept": "application/json;odata=nometadata",
        "Content-Type": "application/json;odata=nometadata"
       }
      },
      "authentication": "@parameters('$authentication')"
     }
    },
    "Get_TT": {
     "runAfter": {
      "Get_Stages": [
       "Succeeded"
      ]
     },
     "type": "OpenApiConnection",
     "inputs": {
      "host": {
       "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
       "connectionName": "shared_sharepointonline",
       "operationId": "HttpRequest"
      },
      "parameters": {
       "dataset": "https://uab365.sharepoint.com/sites/obgyn/OBGYN-Onboarding",
       "parameters/method": "GET",
       "parameters/uri": "_api/web/lists(guid'80bde969-759f-4fb8-9b1d-8425b61ab2b5')/items?$select=Id,Title,TemplateStageId,Anchor,OffsetDays,FixedDate,AssigneeRole,DefaultAssigneeId,Priority,Category,OrderIndex,IsRequired,IsPrereq,PrereqCondition,NeedsApproval&$filter=TemplateId eq @{body('Get_Candidate')?['TemplateId']}&$top=200",
       "parameters/headers": {
        "Accept": "application/json;odata=nometadata",
        "Content-Type": "application/json;odata=nometadata"
       }
      },
      "authentication": "@parameters('$authentication')"
     }
    },
    "Get_Ranks": {
     "runAfter": {
      "Get_TT": [
       "Succeeded"
      ]
     },
     "type": "OpenApiConnection",
     "inputs": {
      "host": {
       "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
       "connectionName": "shared_sharepointonline",
       "operationId": "HttpRequest"
      },
      "parameters": {
       "dataset": "https://uab365.sharepoint.com/sites/obgyn/OBGYN-Onboarding",
       "parameters/method": "GET",
       "parameters/uri": "_api/web/lists(guid'5606c834-55a2-4998-a3d4-fb0297096ce9')/items?$select=Id,RequiresPT&$top=50",
       "parameters/headers": {
        "Accept": "application/json;odata=nometadata",
        "Content-Type": "application/json;odata=nometadata"
       }
      },
      "authentication": "@parameters('$authentication')"
     }
    },
    "Rank_Match": {
     "runAfter": {
      "Get_Ranks": [
       "Succeeded"
      ]
     },
     "type": "Query",
     "inputs": {
      "from": "@body('Get_Ranks')?['value']",
      "where": "@equals(item()?['Id'], coalesce(body('Get_Candidate')?['FacultyRankId'], -1))"
     }
    },
    "PT": {
     "runAfter": {
      "Rank_Match": [
       "Succeeded"
      ]
     },
     "type": "Compose",
     "inputs": "@coalesce(first(body('Rank_Match'))?['RequiresPT'], false)"
    },
    "Select_St": {
     "runAfter": {
      "PT": [
       "Succeeded"
      ]
     },
     "type": "Select",
     "inputs": {
      "from": "@body('Get_Stages')?['value']",
      "select": "@concat('\"', string(item()?['Id']), '\":\"', item()?['Title'], '\"')"
     }
    },
    "StMap": {
     "runAfter": {
      "Select_St": [
       "Succeeded"
      ]
     },
     "type": "Compose",
     "inputs": "@json(concat('{', join(body('Select_St'), ','), '}'))"
    },
    "Select_Ts": {
     "runAfter": {
      "StMap": [
       "Succeeded"
      ]
     },
     "type": "Select",
     "inputs": {
      "from": "@body('Get_TS')?['value']",
      "select": "@concat('\"', string(item()?['Id']), '\":{\"sid\":', string(item()?['StageId']), ',\"name\":\"', outputs('StMap')?[string(item()?['StageId'])], '\",\"ord\":', string(item()?['OrderIndex']), ',\"ph\":\"', coalesce(item()?['Phase'],''), '\"}')"
     }
    },
    "TsMap": {
     "runAfter": {
      "Select_Ts": [
       "Succeeded"
      ]
     },
     "type": "Compose",
     "inputs": "@json(concat('{', join(body('Select_Ts'), ','), '}'))"
    },
    "Anchors": {
     "runAfter": {
      "TsMap": [
       "Succeeded"
      ]
     },
     "type": "Compose",
     "inputs": {
      "LOI": "@coalesce(body('Get_Candidate')?['LOIDate'],'')",
      "LOO Issued": "@coalesce(body('Get_Candidate')?['LOOIssued'],'')",
      "LOO Accepted": "@coalesce(body('Get_Candidate')?['LOOAccepted'],'')",
      "Start": "@coalesce(body('Get_Candidate')?['StartDate'],'')",
      "None": ""
     }
    },
    "Filter_Applicable": {
     "runAfter": {
      "Anchors": [
       "Succeeded"
      ]
     },
     "type": "Query",
     "inputs": {
      "from": "@body('Get_TT')?['value']",
      "where": "@or(and(equals(outputs('Inputs')?['mode'],'prereq'), equals(item()?['IsPrereq'], true), or(empty(item()?['PrereqCondition']), equals(item()?['PrereqCondition'],'Always'), and(equals(item()?['PrereqCondition'],'Requires P&T'), equals(outputs('PT'), true)))), and(equals(outputs('Inputs')?['mode'],'full'), or(equals(item()?['IsPrereq'], false), and(equals(item()?['IsPrereq'], true), equals(outputs('PreDone'), false), or(empty(item()?['PrereqCondition']), equals(item()?['PrereqCondition'],'Always'), and(equals(item()?['PrereqCondition'],'Requires P&T'), equals(outputs('PT'), true)))))))"
     }
    },
    "Select_Payloads": {
     "runAfter": {
      "Filter_Applicable": [
       "Succeeded"
      ]
     },
     "type": "Select",
     "inputs": {
      "from": "@body('Filter_Applicable')",
      "select": {
       "Title": "@item()?['Title']",
       "CandidateId": "@outputs('Inputs')?['candidateId']",
       "CandName": "@body('Get_Candidate')?['Title']",
       "StageId": "@outputs('TsMap')?[string(item()?['TemplateStageId'])]?['sid']",
       "StageName": "@outputs('TsMap')?[string(item()?['TemplateStageId'])]?['name']",
       "StageOrder": "@outputs('TsMap')?[string(item()?['TemplateStageId'])]?['ord']",
       "Phase": "@outputs('TsMap')?[string(item()?['TemplateStageId'])]?['ph']",
       "Priority": "@item()?['Priority']",
       "Category": "@item()?['Category']",
       "AssigneeId": "@if(equals(item()?['AssigneeRole'],'Manager'), body('Get_Candidate')?['ManagerId'], if(equals(item()?['AssigneeRole'],'Person'), item()?['DefaultAssigneeId'], null))",
       "AssigneeRole": "@item()?['AssigneeRole']",
       "Anchor": "@coalesce(item()?['Anchor'],'None')",
       "OffsetDays": "@int(coalesce(item()?['OffsetDays'],0))",
       "FixedDate": "@if(empty(coalesce(item()?['FixedDate'],'')), null, item()?['FixedDate'])",
       "DueDate": "@if(or(equals(coalesce(item()?['Anchor'],'None'),'None'), empty(if(equals(coalesce(item()?['Anchor'],'None'),'Fixed'), coalesce(item()?['FixedDate'],''), coalesce(outputs('Anchors')?[coalesce(item()?['Anchor'],'None')],'')))), null, formatDateTime(addDays(if(equals(coalesce(item()?['Anchor'],'None'),'Fixed'), coalesce(item()?['FixedDate'],''), coalesce(outputs('Anchors')?[coalesce(item()?['Anchor'],'None')],'')), int(coalesce(item()?['OffsetDays'],0))),'yyyy-MM-dd'))",
       "PendingAnchor": "@and(not(equals(coalesce(item()?['Anchor'],'None'),'None')), empty(if(equals(coalesce(item()?['Anchor'],'None'),'Fixed'), coalesce(item()?['FixedDate'],''), coalesce(outputs('Anchors')?[coalesce(item()?['Anchor'],'None')],''))))",
       "IsRequired": "@item()?['IsRequired']",
       "IsPrereq": "@item()?['IsPrereq']",
       "NeedsApproval": "@item()?['NeedsApproval']",
       "UpdatedVia": "Flow"
      }
     }
    },
    "Each_Create": {
     "runAfter": {
      "Select_Payloads": [
       "Succeeded"
      ]
     },
     "type": "Foreach",
     "foreach": "@body('Select_Payloads')",
     "runtimeConfiguration": {
      "concurrency": {
       "repetitions": 8
      }
     },
     "actions": {
      "Create_Task": {
       "runAfter": {},
       "type": "OpenApiConnection",
       "inputs": {
        "host": {
         "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
         "connectionName": "shared_sharepointonline",
         "operationId": "HttpRequest"
        },
        "parameters": {
         "dataset": "https://uab365.sharepoint.com/sites/obgyn/OBGYN-Onboarding",
         "parameters/method": "POST",
         "parameters/uri": "_api/web/lists(guid'c5ee2e83-46d9-4233-a660-b05286a98d11')/items",
         "parameters/headers": {
          "Accept": "application/json;odata=nometadata",
          "Content-Type": "application/json;odata=nometadata"
         },
         "parameters/body": "@string(item())"
        },
        "authentication": "@parameters('$authentication')"
       }
      }
     }
    },
    "If_Full_Finish": {
     "runAfter": {
      "Each_Create": [
       "Succeeded"
      ]
     },
     "type": "If",
     "expression": {
      "and": [
       {
        "equals": [
         "@outputs('Inputs')?['mode']",
         "full"
        ]
       }
      ]
     },
     "actions": {
      "Upd_Stage": {
       "runAfter": {},
       "type": "OpenApiConnection",
       "inputs": {
        "host": {
         "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
         "connectionName": "shared_sharepointonline",
         "operationId": "HttpRequest"
        },
        "parameters": {
         "dataset": "https://uab365.sharepoint.com/sites/obgyn/OBGYN-Onboarding",
         "parameters/method": "POST",
         "parameters/uri": "_api/web/lists(guid'ce3de9a9-702d-4707-9f30-a011b3d78264')/items(@{outputs('Inputs')?['candidateId']})",
         "parameters/headers": {
          "Accept": "application/json;odata=nometadata",
          "Content-Type": "application/json;odata=nometadata",
          "X-HTTP-Method": "MERGE",
          "IF-MATCH": "*"
         },
         "parameters/body": "@string(json(concat('{\"CurrentStageId\":', string(first(sort(body('Get_TS')?['value'],'OrderIndex'))?['StageId']), '}')))"
        },
        "authentication": "@parameters('$authentication')"
       }
      },
      "Add_ChangeLog": {
       "runAfter": {
        "Upd_Stage": [
         "Succeeded"
        ]
       },
       "type": "OpenApiConnection",
       "inputs": {
        "host": {
         "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
         "connectionName": "shared_sharepointonline",
         "operationId": "HttpRequest"
        },
        "parameters": {
         "dataset": "https://uab365.sharepoint.com/sites/obgyn/OBGYN-Onboarding",
         "parameters/method": "POST",
         "parameters/uri": "_api/web/lists(guid'a773279f-734a-4ac4-a7c2-c566b779b145')/items",
         "parameters/headers": {
          "Accept": "application/json;odata=nometadata",
          "Content-Type": "application/json;odata=nometadata"
         },
         "parameters/body": "@string(json(concat('{\"CandidateId\":', string(outputs('Inputs')?['candidateId']), ',\"EventType\":\"Stage\",\"FromValue\":\"\",\"ToValue\":\"', outputs('StMap')?[string(first(sort(body('Get_TS')?['value'],'OrderIndex'))?['StageId'])], '\",\"ChangedDate\":\"', coalesce(body('Get_Candidate')?['LOIDate'],utcNow('yyyy-MM-dd')), 'T12:00:00Z\",\"Automated\":true}')))"
        },
        "authentication": "@parameters('$authentication')"
       }
      },
      "Mk_Folder_Gen": {
       "runAfter": {
        "Add_ChangeLog": [
         "Succeeded"
        ]
       },
       "type": "OpenApiConnection",
       "inputs": {
        "host": {
         "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
         "connectionName": "shared_sharepointonline",
         "operationId": "HttpRequest"
        },
        "parameters": {
         "dataset": "https://uab365.sharepoint.com/sites/obgyn/OBGYN-Onboarding",
         "parameters/method": "POST",
         "parameters/uri": "_api/web/folders",
         "parameters/headers": {
          "Accept": "application/json;odata=nometadata",
          "Content-Type": "application/json;odata=nometadata"
         },
         "parameters/body": "@string(json(concat('{\"ServerRelativeUrl\":\"/sites/obgyn/OBGYN-Onboarding/Onboarding Documents/', replace(body('Get_Candidate')?['Title'],'/','-'), '\"}')))"
        },
        "authentication": "@parameters('$authentication')"
       }
      },
      "Mk_Folder_Restricted": {
       "runAfter": {
        "Mk_Folder_Gen": [
         "Succeeded"
        ]
       },
       "type": "OpenApiConnection",
       "inputs": {
        "host": {
         "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
         "connectionName": "shared_sharepointonline",
         "operationId": "HttpRequest"
        },
        "parameters": {
         "dataset": "https://uab365.sharepoint.com/sites/obgyn/OBGYN-Onboarding",
         "parameters/method": "POST",
         "parameters/uri": "_api/web/folders",
         "parameters/headers": {
          "Accept": "application/json;odata=nometadata",
          "Content-Type": "application/json;odata=nometadata"
         },
         "parameters/body": "@string(json(concat('{\"ServerRelativeUrl\":\"/sites/obgyn/OBGYN-Onboarding/Onboarding Documents Restricted/', replace(body('Get_Candidate')?['Title'],'/','-'), '\"}')))"
        },
        "authentication": "@parameters('$authentication')"
       }
      }
     },
     "else": {
      "actions": {
       "Prereq_Done": {
        "runAfter": {},
        "type": "Compose",
        "inputs": "prereq expansion complete"
       }
      }
     }
    }
   },
   "else": {
    "actions": {
     "Skipped": {
      "runAfter": {},
      "type": "Compose",
      "inputs": "already applied - no action"
     }
    }
   }
  },
  "Result": {
   "runAfter": {
    "If_NotAlready": [
     "Succeeded"
    ]
   },
   "type": "Compose",
   "inputs": {
    "candidateId": "@outputs('Inputs')?['candidateId']",
    "mode": "@outputs('Inputs')?['mode']",
    "already": "@outputs('Already')"
   }
  }
 }
}