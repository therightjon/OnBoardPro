# OnBoardPro Environment Configuration
# Copy this file to .env and update with your values

# ============================================
# Environment
# ============================================
NODE_ENV=development
PORT=5000

# ============================================
# Database
# ============================================
# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/onboardpro

# ============================================
# Security
# ============================================
# Session secret - MUST be at least 32 characters
# Generate with: openssl rand -base64 32
SESSION_SECRET=your-secret-key-minimum-32-characters-long-required

# Optional: Restrict cookies to specific domain
# COOKIE_DOMAIN=.example.com

# ============================================
# Rate Limiting
# ============================================
# Default rate limit: 120 requests per minute
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Sensitive endpoints: 60 requests per minute
SENSITIVE_RATE_LIMIT_WINDOW_MS=60000
SENSITIVE_RATE_LIMIT_MAX=60

# ============================================
# Background Jobs
# ============================================
# Set to '1' to disable specific background jobs
DISABLE_DEADLINE_SCANNER=0
DISABLE_EMAIL_JOBS=0

# ============================================
# SMTP Configuration (Optional)
# ============================================
# Required for email notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ============================================
# OAuth Providers (Optional)
# ============================================

# Google OAuth
ENABLE_GOOGLE_AUTH=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Azure AD OAuth
ENABLE_AZURE_AUTH=false
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=

# ============================================
# LDAP Configuration (Optional)
# ============================================
AUTH_ENABLE_LDAP=false
LDAP_URL=ldaps://ldap.company.com:636
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_BASE_DN=
LDAP_USER_FILTER=(sAMAccountName={{username}})
LDAP_ATTR_USERNAME=sAMAccountName
LDAP_ATTR_FIRST_NAME=givenName
LDAP_ATTR_LAST_NAME=sn
LDAP_ATTR_EMAIL=mail

# Legacy aliases (still supported for compatibility)
# ENABLE_LDAP_AUTH=false
# LDAP_SEARCH_BASE=
# LDAP_SEARCH_FILTER=(uid={{username}})
# LDAP_USERNAME_ATTR=sAMAccountName
# LDAP_FIRSTNAME_ATTR=givenName
# LDAP_LASTNAME_ATTR=sn
# LDAP_EMAIL_ATTR=mail
