AZ_SUBSCRIPTION_ID=
AZ_LOCATION=centralus
AZ_RESOURCE_GROUP=onboardpro-rg

# Container Apps
AZ_CONTAINERAPP_ENV=onboardpro-ca-env
AZ_CONTAINERAPP_NAME=onboardpro
AZ_CONTAINERAPP_CPU=1.0
AZ_CONTAINERAPP_MEMORY=2Gi
AZ_CONTAINERAPP_MIN_REPLICAS=1
AZ_CONTAINERAPP_MAX_REPLICAS=3
AZ_CONTAINERAPP_PORT=5000

# Azure Container Registry (must be lowercase letters/numbers only)
AZ_ACR_NAME=obpacr
AZ_IMAGE_NAME=onboardpro
AZ_IMAGE_TAG=main_deploy_001

# Networking (VNet + private DB)
AZ_DB_PRIVATE=0
AZ_VNET_NAME=onboardpro-vnet
AZ_VNET_PREFIX=10.0.0.0/16
AZ_INFRA_SUBNET_NAME=aca-infra-subnet
AZ_INFRA_SUBNET_PREFIX=10.0.0.0/23
AZ_DB_SUBNET_NAME=postgres-subnet
AZ_DB_SUBNET_PREFIX=10.0.2.0/24
AZ_PRIVATE_DNS_ZONE=privatelink.postgres.database.azure.com

# PostgreSQL flexible server (private access)
AZ_POSTGRES_SERVER=onboardpro-pg-private
AZ_POSTGRES_DB=onboardpro
AZ_POSTGRES_ADMIN_USER=onboardpro_admin
AZ_POSTGRES_ADMIN_PASSWORD=Admin1234!UaB!
AZ_POSTGRES_VERSION=16
AZ_POSTGRES_TIER=Burstable
AZ_POSTGRES_SKU=Standard_B1ms
AZ_POSTGRES_STORAGE_GB=32

# App settings
NODE_ENV=production
PORT=5000
DATABASE_URL=
SESSION_SECRET=a13725333446cf953d22956b6818a14f5f5df9b3de8ec870be5e2798c18f44bc
APP_BASE_URL=
BASE_URL=

# Optional app settings
COOKIE_DOMAIN=
TRUSTED_PROXIES=
SESSION_IDLE_TIMEOUT_HOURS=
SESSION_ABSOLUTE_TIMEOUT_HOURS=
RATE_LIMIT_WINDOW_MS=
RATE_LIMIT_MAX=300
SENSITIVE_RATE_LIMIT_WINDOW_MS=
SENSITIVE_RATE_LIMIT_MAX=200
DISABLE_DEADLINE_SCANNER=
DISABLE_EMAIL_JOBS=
DISABLE_NOTIFICATION_CLEANUP=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
ENABLE_GOOGLE_AUTH=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ENABLE_AZURE_AUTH=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
ENABLE_LDAP_AUTH=false
AUTH_ENABLE_LDAP=false
LDAP_URL=ldaps://ad.hs.uab.edu:636
LDAP_STARTTLS=false
LDAP_BIND_DN="CN=svc-account,OU=Service Accounts,OU=UABHS Users,DC=ad,DC=hs,DC=uab,DC=edu"
LDAP_BIND_PASSWORD=********
LDAP_SEARCH_BASE="OU=UABHS Users,DC=ad,DC=hs,DC=uab,DC=edu"
LDAP_BASE_DN="OU=UABHS Users,DC=ad,DC=hs,DC=uab,DC=edu"
LDAP_SEARCH_FILTER=
LDAP_USER_FILTER=sAMAccountName={{username}}
LDAP_ATTR_USERNAME=sAMAccountName
LDAP_ATTR_EMAIL=mail
LDAP_ATTR_FIRST_NAME=givenName
LDAP_ATTR_LAST_NAME=sn
LDAP_DISABLED_FILTER=
