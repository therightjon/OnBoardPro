# Azure deployment settings
AZ_SUBSCRIPTION_ID=
AZ_LOCATION=eastus
AZ_RESOURCE_GROUP=onboardpro-rg
AZ_APP_SERVICE_PLAN=onboardpro-plan
AZ_APP_PLAN_SKU=B1
AZ_APP_NAME=onboardpro-app

# Optional: change runtime string; list with `az webapp list-runtimes --os linux`
AZ_RUNTIME=NODE|22-lts

# App settings (required)
# Use a URL-safe password in DATABASE_URL or set DATABASE_URL directly if encoding is needed.
DATABASE_URL=
SESSION_SECRET=change-me-min-32-chars

# App settings (recommended)
APP_BASE_URL=https://onboardpro-app.azurewebsites.net
BASE_URL=https://onboardpro-app.azurewebsites.net

# App settings (optional)
COOKIE_DOMAIN=
TRUSTED_PROXIES=
SESSION_IDLE_TIMEOUT_HOURS=
SESSION_ABSOLUTE_TIMEOUT_HOURS=
RATE_LIMIT_WINDOW_MS=
RATE_LIMIT_MAX=
SENSITIVE_RATE_LIMIT_WINDOW_MS=
SENSITIVE_RATE_LIMIT_MAX=
DISABLE_DEADLINE_SCANNER=
DISABLE_EMAIL_JOBS=
DISABLE_NOTIFICATION_CLEANUP=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
ENABLE_GOOGLE_AUTH=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ENABLE_AZURE_AUTH=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
ENABLE_LDAP_AUTH=
LDAP_URL=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_SEARCH_BASE=
LDAP_SEARCH_FILTER=

# Optional: Azure Database for PostgreSQL Flexible Server
# Set AZ_CREATE_DB=1 to enable provisioning.
AZ_CREATE_DB=0
AZ_POSTGRES_SERVER=onboardpro-pg
AZ_POSTGRES_DB=onboardpro
AZ_POSTGRES_ADMIN_USER=onboardpro_admin
AZ_POSTGRES_ADMIN_PASSWORD=
AZ_POSTGRES_VERSION=16
AZ_POSTGRES_TIER=Burstable
AZ_POSTGRES_SKU=Standard_B1ms
AZ_POSTGRES_STORAGE_GB=32
# Check `az postgres flexible-server create -h` for allowed public access values.
AZ_POSTGRES_PUBLIC_ACCESS=
