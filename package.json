    "pg": "^8.12.0",
    "react": "^18.3.1",
    "react-day-picker": "^8.10.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.55.0",
    "sonner": "^2.0.7",
    "swagger-ui-express": "^5.0.1",
    "tailwind-merge": "^2.6.0",
