{
  "name": "rest-express",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx -r dotenv/config server/index.ts",
    "dev:bun": "NODE_ENV=development bun --watch server/index.ts",
    "build": "vite build && esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "start": "NODE_ENV=production node dist/index.js",
    "start:bun": "NODE_ENV=production bun server/index.ts",
    "check": "tsc",
    "db:push": "drizzle-kit push",
    "db:import": "tsx scripts/importDatabaseExport.ts database_export.sql",
    "db:run-sql": "node scripts/runSqlFiles.mjs",
    "user:set-password": "tsx scripts/setPassword.ts",
    "test": "npm run test:backend && npm run test:frontend",
    "test:bun": "bun test",
    "test:backend": "cross-env NODE_ENV=test SKIP_AUTH_SETUP=1 tsx --test 'server/tests/{auth,routes,repositories,db,services,utils}/**/*.test.ts'",
    "test:frontend": "vitest run",
    "test:auth": "cross-env NODE_ENV=test SKIP_AUTH_SETUP=1 tsx --test server/tests/auth/**/*.test.ts",
    "test:routes": "cross-env NODE_ENV=test SKIP_AUTH_SETUP=1 tsx --test server/tests/routes/**/*.test.ts",
    "test:db": "cross-env NODE_ENV=test SKIP_AUTH_SETUP=1 tsx --test server/tests/db/**/*.test.ts",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "bun:compat": "bun scripts/bun-compatibility-test.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@hookform/resolvers": "^5.2.2",
    "@jridgewell/trace-mapping": "^0.3.25",
    "@neondatabase/serverless": "^0.10.4",
    "@radix-ui/react-alert-dialog": "^1.1.7",
    "@radix-ui/react-avatar": "^1.1.4",
    "@radix-ui/react-checkbox": "^1.1.5",
    "@radix-ui/react-dialog": "^1.1.7",
    "@radix-ui/react-dropdown-menu": "^2.1.7",
    "@radix-ui/react-label": "^2.1.3",
    "@radix-ui/react-popover": "^1.1.7",
    "@radix-ui/react-radio-group": "^1.2.4",
    "@radix-ui/react-scroll-area": "^1.2.4",
    "@radix-ui/react-select": "^2.1.7",
    "@radix-ui/react-separator": "^1.1.3",
