# Database connection (PostgreSQL)
DATABASE_URL=postgres://db_user:ThisIsAStrongPassword567!@localhost:5432/onboardpro
POSTGRES_USER=db_user
POSTGRES_PASSWORD=ThisIsAStrongPassword567!
POSTGRES_DB=onboardpro

# Turn LDAP provider on/off
AUTH_ENABLE_LDAP=true

# LDAP URL (required by auth service)
LDAP_URL=ldaps://ad.hs.uab.edu:636

# Connection details
LDAP_HOST=ad.hs.uab.edu
LDAP_PORT=636
LDAP_USE_LDAPS=true        # true = ldaps:// (port 636), false = ldap:// (port 389)
LDAP_STARTTLS=false        # set true if using StartTLS on port 389

# Search base (from your osTicket config)
LDAP_BASE_DN=OU=UABHS Users,DC=ad,DC=hs,DC=uab,DC=edu

# Service account (for search bind; optional if you use direct bind only)
LDAP_BIND_DN=CN=svc-account,OU=Service Accounts,OU=UABHS Users,DC=ad,DC=hs,DC=uab,DC=edu
LDAP_BIND_PASSWORD=********

# Attribute mapping (Active Directory defaults)
LDAP_USERNAME_ATTR=sAMAccountName
LDAP_EMAIL_ATTR=mail
LDAP_FIRSTNAME_ATTR=givenName
LDAP_LASTNAME_ATTR=sn

# UPN suffix to build user bind strings (when you want username@domain style)
LDAP_BIND_UPN_SUFFIX=@ad.hs.uab.edu

# Timeouts (optional)
LDAP_TIMEOUT_MS=8000

# ============================================
# Security
# ============================================
# Session secret - MUST be at least 32 characters
# Generate with: openssl rand -base64 32
SESSION_SECRET=Y+ppVOGiULfyOQohi41Q3rogH5kapDvXRXt/2WB2E5c=

# Rate limiting (requests per minute)
SENSITIVE_RATE_LIMIT_MAX=200
RATE_LIMIT_MAX=300
